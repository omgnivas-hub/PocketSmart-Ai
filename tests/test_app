def test_home_plan_demo_mode(authed):
    body = {"total_budget": 100000, "num_lights": 6, "num_fans": 3, "num_furniture": 4, "num_dining_tables": 1,
            "has_living_room": True, "has_kitchen": True, "has_bedroom": False}
    r = authed.post("/home-budget", json=body)
    assert r.status_code == 200, r.text
    d = r.json()
    assert d["source"] == "fallback" and d["kind"] == "home"
    assert d["allocated"] <= 100000 and not d["over_budget"]
    assert abs(d["allocated"] + d["remaining_budget"] - 100000) < 0.01
    assert {c["category"] for c in d["budget_breakdown"]} == {"lighting", "ceiling_fans", "furniture", "dining_tables"}
    assert d["budget_breakdown"][0]["items"][0]["shopping_links"]["amazon"].startswith("https://www.amazon.in/s?k=")
    assert authed.post("/generate-home", json=body).status_code == 200  # alias route


def test_home_validation(authed):
    r = authed.post("/home-budget", json={"total_budget": 5000})  # no items requested
    assert r.status_code == 422
    r = authed.post("/home-budget", json={"total_budget": -5, "num_lights": 1})
    assert r.status_code == 422


def test_party_plan_demo_mode(authed):
    r = authed.post("/party-budget", json={"total_budget": 50000, "num_guests": 25, "party_type": "Birthday",
                                           "venue_type": "Banquet hall"})
    assert r.status_code == 200, r.text
    d = r.json()
    cats = {c["category"] for c in d["budget_breakdown"]}
    assert {"venue", "catering", "decoration", "entertainment", "contingency"} <= cats
    assert d["venue_suggestions"] and d["allocated"] <= 50000
    assert authed.post("/party-budget", json={"total_budget": 1000, "num_guests": 5, "needs_catering": False,
                                              "needs_decoration": False, "needs_entertainment": False}).status_code == 422


def test_jewelry_plan_with_and_without_image(authed):
    r = authed.post("/jewelry-budget", data={"total_budget": "20000", "occasion": "Wedding", "preferences": "gold"})
    assert r.status_code == 200, r.text
    assert r.json()["outfit_analysis"] is None and len(r.json()["jewelry_recommendations"]) == 3

    buf = io.BytesIO()
    Image.new("RGB", (80, 80), (30, 60, 200)).save(buf, "PNG")
    r = authed.post("/jewelry-budget", data={"total_budget": "20000", "occasion": "Party"},
                    files={"image": ("outfit.png", buf.getvalue(), "image/png")})
    assert r.status_code == 200, r.text
    assert "blue" in r.json()["outfit_analysis"]["colors"]
    assert list(cfg.UPLOAD_DIR.glob("*.jpg")) == []  # uploads are removed after analysis

    bad = authed.post("/jewelry-budget", data={"total_budget": "20000", "occasion": "Party"},
                      files={"image": ("x.png", b"not an image", "image/png")})
    assert bad.status_code == 400


