def test_ai_path_with_stubbed_gemini(authed, monkeypatch):
    """Simulate Gemini output, including fenced JSON, string prices and wrong self-reported totals."""
    monkeypatch.setattr(cfg, "GEMINI_API_KEY", "fake-key")
    calls = []

    def fake(prompt, image_path=None):
        calls.append(prompt)
        return gemini_utils._extract_json(
            '```json\n{"budget_breakdown":[{"category":"Ceiling Fans","items":[{"name":"Havells fan",'
            '"description":"5 star","estimated_price":"₹2,500","quantity":"2","search_terms":"havells 1200mm fan"}]}],'
            '"additional_suggestions":["Compare prices"],"total_cost":1}\n```')

    monkeypatch.setattr(gemini_utils, "_call_gemini", fake)
    r = authed.post("/home-budget", json={"total_budget": 10000, "num_fans": 2})
    d = r.json()
    assert r.status_code == 200 and d["source"] == "gemini"
    item = d["budget_breakdown"][0]["items"][0]
    assert item["estimated_price"] == 2500 and item["line_total"] == 5000 and d["remaining_budget"] == 5000
    assert "flipkart" in item["shopping_links"] and d["budget_breakdown"][0]["category"] == "ceiling_fans"


def test_ai_over_budget_retries_then_falls_back(authed, monkeypatch):
    monkeypatch.setattr(cfg, "GEMINI_API_KEY", "fake-key")
    calls = []

    def greedy(prompt, image_path=None):
        calls.append(prompt)
        return {"budget_breakdown": [{"category": "furniture", "items": [
            {"name": "Sofa", "estimated_price": 999999, "quantity": 1, "search_terms": "sofa"}]}]}

    monkeypatch.setattr(gemini_utils, "_call_gemini", greedy)
    d = authed.post("/home-budget", json={"total_budget": 20000, "num_furniture": 1}).json()
    assert len(calls) == 2 and "IMPORTANT" in calls[1]
    assert d["source"] == "fallback" and d["allocated"] <= 20000 and "over budget" in d["notice"]


def test_ai_failure_falls_back(authed, monkeypatch):
    monkeypatch.setattr(cfg, "GEMINI_API_KEY", "fake-key")

    def boom(prompt, image_path=None):
        raise RuntimeError("network down")

    monkeypatch.setattr(gemini_utils, "_call_gemini", boom)
    d = authed.post("/party-budget", json={"total_budget": 20000, "num_guests": 10}).json()
    assert d["source"] == "fallback" and "unavailable" in d["notice"]


def test_extract_json_variants():
    assert gemini_utils._extract_json('{"a": 1}') == {"a": 1}
    assert gemini_utils._extract_json('Here you go:\n{"a": 2}\nThanks') == {"a": 2}
    with pytest.raises(ValueError):
        gemini_utils._extract_json("no json at all")
    with pytest.raises(ValueError):
        gemini_utils._extract_json("")


def test_logout_invalidates_token(client):
    c = TestClient(main.app)
    c.post("/token", data={"username": "tester", "password": "secret123"})
    assert c.get("/session-info").status_code == 200
    token = c.cookies.get("access_token")
    c.get("/logout", follow_redirects=False)
    stale = TestClient(main.app)
    stale.cookies.set("access_token", token)
    assert stale.get("/session-info").status_code == 401
